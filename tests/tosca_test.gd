extends "res://tests/cistern_test.gd"

var completions: int = 0


func _count_completion() -> void:
	completions += 1


func _run() -> void:
	var scene = load("res://Cisternerne.tscn").instantiate()
	root.add_child(scene)
	scene.transition_duration = 0.015
	scene.tosca.completed.connect(_count_completion)
	await _settle()
	_check(scene.doors[1].available and scene.doors[1].title == "Tosca", "Door II must be the playable Tosca door.")
	_check(not scene.tosca.active and not scene.tosca.wind.playing, "The tower must be inactive while in the lobby.")
	scene.enter_door(1)
	_check(not scene.transitioning, "The closed Tosca door must not allow entry.")
	scene.enter_door(2)
	_check(not scene.transitioning, "Unimplemented doors must not allow entry.")
	scene.tosca.start()
	_check(not scene.tosca.running, "The Tosca sequence must not start remotely.")
	var click := InputEventMouseButton.new()
	click.button_index = MOUSE_BUTTON_LEFT
	click.pressed = true
	Input.parse_input_event(click)
	Input.flush_buffered_events()
	_face(scene.player, scene.doors[1])
	await _settle()
	_key(KEY_W, true)
	await _settle(75)
	_key(KEY_W, false)
	var local: Vector3 = scene.doors[1].to_local(scene.player.viewer_position())
	_check(local.z > 0.1 and scene.current_space == "lobby", "The closed second door must physically block entry.")
	_face(scene.player, scene.doors[1])
	await _settle()
	scene.player._update_focus()
	_check(scene.player.focused == scene.doors[1], "The pointer must select Tosca.")
	_check(scene._context_prompt().contains("II") and scene._context_prompt().contains("Tosca"), "The prompt must identify door II rather than door I.")
	_key(KEY_E, true)
	_key(KEY_E, false)
	_check(scene.doors[1].is_open, "E must open the Tosca door.")
	_check(not scene.doors[0].is_open, "Opening Tosca must not open La traviata.")
	await _settle(80)
	_key(KEY_W, true)
	for frame in range(110):
		if scene.transitioning:
			break
		await physics_frame
	_key(KEY_W, false)
	_check(scene.transitioning, "Crossing the second threshold must begin a transition.")
	await _transition(scene)
	_check(scene.current_space == "tosca" and scene.tosca.active, "Door II must lead to the tower.")
	_check(scene.player.desktop.position.x > 65, "The player must arrive in Tosca's separate play space.")
	_check(scene.tosca.wind.playing and not scene.sound.breathing.playing, "The tower must play wind rather than Violetta's breathing.")
	_check(not scene.tosca.running, "Arrival must wait for the player's start interaction.")
	_check(scene.tosca.figure.visible and not scene.doors[1].completed, "The first visit must show the figure without recording completion.")
	# The parapet is a real collider; the avatar cannot simply walk off the tower.
	scene.player.relocate(scene.TOSCA_ROOM + Vector3(2, 0.03, -3.4))
	_key(KEY_W, true)
	await _settle(50)
	_key(KEY_W, false)
	_check(scene.player.desktop.position.z > -4.3, "The parapet must stop walking over the edge.")
	_check(absf(scene.player.desktop.position.y) < 0.1, "The viewer must remain on the terrace floor.")
	scene.player.relocate(scene.TOSCA_ROOM + Vector3(0, 0.03, -3.4))
	_key(KEY_W, true)
	await _settle(50)
	_key(KEY_W, false)
	_check(scene.player.desktop.position.z > -4.3 and absf(scene.player.desktop.position.y) < 0.1, "The open-looking railing must also physically block walking over the edge.")
	_face(scene.player, scene.tosca.start_action)
	await _settle()
	scene.player._update_focus()
	_check(scene.player.focused == scene.tosca.start_action, "The start action on the terrace must be selectable.")
	_key(KEY_E, true)
	_key(KEY_E, false)
	_check(scene.tosca.running and scene.tosca.bell.playing, "Starting Tosca must start its sequence and bell.")
	scene.tosca.advance(12)
	_key(KEY_R, true)
	_key(KEY_R, false)
	await _transition(scene)
	_check(scene.current_space == "lobby" and not scene.tosca.active, "R must interrupt Tosca and return to the lobby.")
	_check(not scene.tosca.wind.playing and not scene.tosca.bell.playing, "Early exit must stop both Tosca sounds.")
	_check(not scene.doors[1].completed and completions == 0, "An interrupted first visit must not be counted as complete.")
	_check(not scene.doors[1].is_open, "The second door must close on return.")

	scene.doors[1].activate()
	scene.enter_door(1)
	await _transition(scene)
	_check(scene.tosca.elapsed == 0 and scene.tosca.figure.visible, "Re-entry must restore the figure and timing.")
	_face(scene.player, scene.tosca.start_action)
	await _settle()
	scene.player._update_focus()
	_key(KEY_E, true)
	_key(KEY_E, false)
	scene.tosca.set_process(false)
	_check(scene.tosca.running, "The experience must be startable again after an interruption.")
	var view_before: Transform3D = scene.player.camera.global_transform
	scene.tosca.advance(12)
	_check(scene.tosca.stage == 1, "The pre-fall narrative must appear first.")
	_check(scene.tosca.figure.position.is_equal_approx(scene.tosca.FIGURE_HOME), "The figure must wait until the fall phase.")
	scene.tosca.advance(16)
	_check(scene.tosca.stage == 2 and scene.tosca.figure.position.y < -1.0, "The figure must visibly descend during the fall.")
	_check(scene.tosca.scarf.position.y < 1.6, "The red scarf must descend with its own slower motion.")
	_check(scene.player.camera.global_transform.is_equal_approx(view_before), "The fall must not move or rotate the viewer's camera.")
	scene.tosca.advance(8)
	_check(scene.tosca.stage == 3 and not scene.tosca.figure.visible, "The figure must disappear below the terrace in the aftermath.")
	scene.tosca.advance(42)
	_check(scene.tosca.finished and not scene.tosca.running, "The full Tosca sequence must end.")
	_check(scene.doors[1].completed and not scene.doors[0].completed, "Tosca must update only its own door's progress.")
	_check(scene.tosca.start_action.enabled and scene.tosca.story.text.contains("Faldet er forbi"), "The ending must remain visible and offer a replay.")
	scene.tosca.advance(100)
	_check(completions == 1, "Completion must be emitted exactly once.")
	scene.tosca.set_process(true)
	_face(scene.player, scene.tosca.return_action)
	await _settle()
	scene.player._update_focus()
	_check(scene.player.focused == scene.tosca.return_action, "The tower's return doorway must be selectable.")
	_key(KEY_E, true)
	_key(KEY_E, false)
	await _transition(scene)
	_check(scene.current_space == "lobby" and not scene.tosca.wind.playing, "The return door must restore the lobby and stop the wind.")
	_check(scene.doors[1].hint.text.contains("OPLEVET"), "Door II must show its completed status.")
	_check(not scene.doors[0].completed, "La traviata must remain independent after return.")
	scene.doors[1].activate()
	scene.enter_door(1)
	await _transition(scene)
	_check(not scene.tosca.finished and scene.tosca.figure.visible, "A completed experience must still reset for a repeat visit.")
	var bounds: Vector3 = scene._constrain_xr(Vector3(200, 0, -100))
	_check(bounds.x > 65 and bounds.x <= 73.5 and bounds.z >= -3.8, "VR movement bounds must follow the player to the tower.")
	scene.return_to_lobby()
	await _transition(scene)
	_check(scene.doors[1].completed and completions == 1, "An unstarted repeat visit must preserve the previous completion without adding one.")
	scene.queue_free()
	await process_frame
	await create_timer(0.2).timeout
	print("Tosca tests: %d checks, %d failures." % [checks, failures])
	quit(0 if failures == 0 else 1)
