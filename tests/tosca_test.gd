extends "res://tests/cistern_test.gd"

var completions: int = 0


func _count_completion() -> void:
	completions += 1


func _run() -> void:
	var scene = load("res://Cisternerne.tscn").instantiate()
	root.add_child(scene)
	scene.transition_duration = 0.015
	scene.tosca.completed.connect(_count_completion)
	await _settle()
	_check(scene.doors[1].available and scene.doors[1].title == "Tosca", "Door II must be the playable Tosca door.")
	_check(not scene.tosca.active and not scene.tosca.wind.playing, "The tower must be inactive while in the lobby.")
	scene.enter_door(1)
	_check(not scene.transitioning, "The closed Tosca door must not allow entry.")
	scene.enter_door(2)
	_check(not scene.transitioning, "Unimplemented doors must not allow entry.")
	scene.tosca.start()
	_check(not scene.tosca.running, "The Tosca sequence must not start remotely.")
	var click := InputEventMouseButton.new()
	click.button_index = MOUSE_BUTTON_LEFT
	click.pressed = true
	Input.parse_input_event(click)
	Input.flush_buffered_events()
	_face(scene.player, scene.doors[1])
	await _settle()
	_key(KEY_W, true)
	await _settle(75)
	_key(KEY_W, false)
	var local: Vector3 = scene.doors[1].to_local(scene.player.viewer_position())
	_check(local.z > 0.1 and scene.current_space == "lobby", "The closed second door must physically block entry.")
	_face(scene.player, scene.doors[1])
	await _settle()
	scene.player._update_focus()
	_check(scene.player.focused == scene.doors[1], "The pointer must select Tosca.")
	_check(scene._context_prompt().contains("II") and scene._context_prompt().contains("Tosca"), "The prompt must identify door II rather than door I.")
	_key(KEY_E, true)
	_key(KEY_E, false)
	_check(scene.doors[1].is_open, "E must open the Tosca door.")
	_check(not scene.doors[0].is_open, "Opening Tosca must not open La traviata.")
	await _settle(80)
	_key(KEY_W, true)
	for frame in range(110):
		if scene.transitioning:
			break
		await physics_frame
	_key(KEY_W, false)
	_check(scene.transitioning, "Crossing the second threshold must begin a transition.")
	await _transition(scene)
	_check(scene.current_space == "tosca" and scene.tosca.active, "Door II must lead to the tower.")
	_check(scene.player.desktop.position.x > 65, "The player must arrive in Tosca's separate play space.")
	_check(scene.tosca.wind.playing and not scene.sound.breathing.playing, "The tower must play wind rather than Violetta's breathing.")
	_check(not scene.tosca.running, "Arrival must wait for the player's start interaction.")
	_check(scene.tosca.state == "ready" and not scene.doors[1].completed, "Arrival must prepare the first-person experience without recording completion.")
	# The parapet is a real collider; the avatar cannot simply walk off the tower.
	scene.player.relocate(scene.TOSCA_ROOM + Vector3(2, 0.03, -3.4))
	_key(KEY_W, true)
	await _settle(50)
	_key(KEY_W, false)
	_check(scene.player.desktop.position.z > -4.3, "The parapet must stop walking over the edge.")
	_check(absf(scene.player.desktop.position.y) < 0.1, "The viewer must remain on the terrace floor.")
	scene.player.relocate(scene.TOSCA_ROOM + Vector3(0, 0.03, -3.4))
	_key(KEY_W, true)
	await _settle(50)
	_key(KEY_W, false)
	_check(scene.player.desktop.position.z > -4.3 and absf(scene.player.desktop.position.y) < 0.1, "The open-looking railing must also physically block walking over the edge.")
	_face(scene.player, scene.tosca.start_action)
	await _settle()
	scene.player._update_focus()
	_check(scene.player.focused == scene.tosca.start_action, "The start action on the terrace must be selectable.")
	_key(KEY_E, true)
	_key(KEY_E, false)
	_check(scene.tosca.running and scene.tosca.bell.playing, "Starting Tosca must start its sequence and bell.")
	scene.tosca.set_process(false)
	scene.tosca.advance(100)
	_check(scene.tosca.state == "awaiting_fall" and not scene.player.sequence_motion_active, "The intro must wait for confirmation rather than making the player fall automatically.")
	scene.tosca.confirm_fall()
	_check(scene.tosca.state == "awaiting_fall", "The player must approach the edge before confirming.")
	_key(KEY_W, true)
	await _settle(55)
	_key(KEY_W, false)
	scene.player._update_focus()
	_check(scene.player.focused == scene.tosca.fall_action, "The edge confirmation must be reachable after walking forward.")
	var initial_view: Vector3 = scene.player.viewer_position()
	_key(KEY_E, true)
	_key(KEY_E, false)
	_check(scene.tosca.state == "falling" and scene.player.sequence_motion_active, "Confirming at the edge must begin a first-person fall.")
	scene.tosca.advance(2.5)
	_check(scene.player.viewer_position().y < initial_view.y - 3.0, "The actual player viewpoint must fall below the terrace.")
	_check(not scene.player.interaction_enabled, "Other interactions must be blocked during the fall.")
	_key(KEY_R, true)
	_key(KEY_R, false)
	await _transition(scene)
	_check(scene.current_space == "lobby" and not scene.tosca.active, "R must interrupt an active fall and return to the lobby.")
	_check(not scene.player.sequence_motion_active and scene.player.locomotion_enabled, "An interrupted fall must restore normal movement.")
	_check(scene.player.global_position.is_zero_approx() and is_zero_approx(scene.fade_material.albedo_color.a), "Return must clear the rig offset and black fade.")
	_check(not scene.tosca.wind.playing and not scene.tosca.bell.playing, "Early exit must stop both Tosca sounds.")
	_check(not scene.doors[1].completed and completions == 0, "An interrupted first fall must not be counted as complete.")
	_check(not scene.doors[1].is_open, "The second door must close on return.")

	scene.doors[1].activate()
	scene.enter_door(1)
	await _transition(scene)
	scene.tosca.set_process(false)
	_check(scene.tosca.elapsed == 0 and scene.tosca.state == "ready", "Re-entry must reset timing and confirmation.")
	scene.tosca.start()
	scene.tosca.advance(100)
	scene.player.relocate(scene.TOSCA_ROOM + Vector3(0, 0.03, -3.3))
	await _settle()
	scene.player._update_focus()
	_check(scene.player.focused == scene.tosca.fall_action, "The full fall must also use the normal interaction path.")
	var view_before: Transform3D = scene.player.camera.global_transform
	var head_before: Transform3D = scene.player.head.global_transform
	var tracking_pose: Transform3D = scene.player.head.transform
	_key(KEY_E, true)
	_key(KEY_E, false)
	scene.tosca.advance(1.8)
	_check(scene.player.camera.global_position.y < view_before.origin.y - 1.0, "The desktop camera must descend during a full fall.")
	_check(scene.player.camera.global_position.z < -5.5, "The falling viewpoint must clear the tower's ledge.")
	scene.tosca.advance(1.5)
	_check(scene.player.camera.global_position.y < view_before.origin.y - 9.0, "The viewpoint must accelerate down the tower.")
	_check(scene.player.camera.global_basis.is_equal_approx(view_before.basis), "The sequence must not force camera rotation or roll.")
	_check(scene.player.head.transform.is_equal_approx(tracking_pose), "The live local headset pose must not be overwritten.")
	var camera_delta: Vector3 = scene.player.camera.global_position - view_before.origin
	var head_delta: Vector3 = scene.player.head.global_position - head_before.origin
	_check(camera_delta.is_equal_approx(head_delta), "The complete XR rig must descend by the same amount as the desktop camera.")
	var held_view: Vector3 = scene.player.viewer_position()
	await _settle(3)
	_check(scene.player.viewer_position().is_equal_approx(held_view), "Normal gravity or movement must not overwrite a paused sequence pose.")
	scene.tosca.advance(0.9)
	_check(scene.fade_material.albedo_color.a > 0.1, "The view must fade before the end of the descent.")
	scene.tosca.advance(0.6)
	_check(scene.tosca.state == "ending" and not scene.player.sequence_motion_active, "The rig must return to the terrace under the black fade.")
	_check(scene.fade_material.albedo_color.a > 0.99, "The position restoration must happen while the view is black.")
	scene.tosca.advance(scene.tosca.outro_duration)
	_check(scene.tosca.finished and not scene.tosca.running, "The first-person experience must finish after the outro.")
	_check(scene.doors[1].completed and not scene.doors[0].completed, "Tosca must update only its own door's progress.")
	_check(scene.player.interaction_enabled and scene.player.locomotion_enabled, "Completing the fall must restore controls.")
	_check(is_zero_approx(scene.fade_material.albedo_color.a), "The completion view must become visible again.")
	_check(scene.tosca.start_action.enabled and scene.tosca.story.text.contains("Faldet er forbi"), "The ending must offer a replay.")
	scene.tosca.advance(100)
	_check(completions == 1, "Completion must be emitted exactly once.")
	_face(scene.player, scene.tosca.return_action)
	await _settle()
	scene.player._update_focus()
	_check(scene.player.focused == scene.tosca.return_action, "The tower's return doorway must be selectable after a fall.")
	_key(KEY_E, true)
	_key(KEY_E, false)
	await _transition(scene)
	_check(scene.current_space == "lobby" and not scene.tosca.wind.playing, "The return door must restore the lobby and stop the wind.")
	_check(scene.doors[1].hint.text.contains("OPLEVET"), "Door II must show its completed status.")

	# Select the shorter fall through its real in-world interaction.
	scene.doors[1].activate()
	scene.enter_door(1)
	await _transition(scene)
	scene.tosca.set_process(false)
	_face(scene.player, scene.tosca.mode_action)
	await _settle()
	scene.player._update_focus()
	_check(scene.player.focused == scene.tosca.mode_action, "The fall mode control must be selectable.")
	_key(KEY_E, true)
	_key(KEY_E, false)
	_check(scene.tosca.gentle_fall and scene.tosca.mode_action.prompt.contains("KORT"), "The mode control must switch to a shorter first-person fall.")
	scene.tosca.start()
	scene.tosca.advance(100)
	scene.player.relocate(scene.TOSCA_ROOM + Vector3(0, 0.03, -3.3))
	scene.tosca.confirm_fall()
	initial_view = scene.player.viewer_position()
	scene.tosca.toggle_fall_mode()
	_check(scene.tosca.gentle_fall, "The chosen mode must stay fixed during a fall.")
	scene.tosca.advance(3.6)
	var drop: float = initial_view.y - scene.player.viewer_position().y
	_check(drop > 0.5 and drop <= 4.1, "The shorter mode must still move the player, with a limited drop.")
	_check(scene.fade_material.albedo_color.a > 0.99, "The shorter mode must fade earlier.")
	scene.tosca.advance(100)
	_check(scene.tosca.finished and completions == 2, "The shorter experience must also complete exactly once.")
	var bounds: Vector3 = scene._constrain_xr(Vector3(200, 0, -100))
	_check(bounds.x > 65 and bounds.x <= 73.5 and bounds.z >= -3.8, "Normal VR exploration must still respect the tower boundary.")
	scene.return_to_lobby()
	await _transition(scene)
	_check(not scene.doors[0].completed and scene.doors[1].completed, "First-person replays must preserve independent door progress.")
	scene.queue_free()
	await process_frame
	await create_timer(0.2).timeout
	print("Tosca tests: %d checks, %d failures." % [checks, failures])
	quit(0 if failures == 0 else 1)
