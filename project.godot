; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Museumsprojekt"
run/main_scene="res://Cisternerne.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1152
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[input]

museum_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
museum_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
museum_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
museum_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"

[xr]

openxr/enabled=true
shaders/enabled=true
